---
import Layout from '../layouts/Layout.astro';
import { ContentService } from '../services/contentService';
import CompetenceSelector from '../components/CompetenceSelector';
import HolisticAdvisorySection from '../components/HolisticAdvisorySection';

const programs = await ContentService.getPrograms();

const videoTestimonials = [
  {
    id: "urJCaMqSQ-M",
    title: "Endrit Osmani: Disziplin, Einsatz & Vorbildfunktion",
    description: "Endrit zeigt, was konsequenter Einsatz, Disziplin und Teamgedanke in der Finanzberatung bewirken können – geprägt durch eine klare Haltung und spürbare Motivation.",
    label: "Kathiago Talent"
  },
  {
    id: "EQcNS_z8rdM",
    title: "Remzi Bilginer: Klarheit, Disziplin & Leadership",
    description: "Remzi steht für Fokus, Zielstrebigkeit und Leadership. Sein Weg zeigt, wie klare Entscheidungen und persönliche Disziplin nachhaltige Entwicklung ermöglichen.",
    label: "Kathiago Talent"
  },
  {
    id: "1j2RAO1muEc",
    title: "Sandro Lapini: Präsenz, Durchhaltewille & Glaubwürdigkeit",
    description: "Sandro überzeugt durch Präsenz, Aufnahmefähigkeit und innere Stärke. Ein Beispiel dafür, wie Durchhaltewille und Glaubwürdigkeit den eigenen Weg prägen.",
    label: "Kathiago Talent"
  },
  {
    id: "XiQ7BFaO3Ck",
    title: "Sven Damay: Verständnis, Haltung & Kundenfokus",
    description: "Sven steht für echtes Verständnis, positive Energie und konsequenten Kundenfokus. Sein Weg zeigt, wie wichtig Haltung in der Finanzberatung ist.",
    label: "Kathiago Talent"
  },
  {
    id: "WDisy9A010U",
    title: "Florian Krasniqi: Authentizität, Drive & Vertrieb",
    description: "Florian bringt Authentizität, Energie und Vertriebsstärke zusammen. Sein Beispiel zeigt, wie Drive und Echtheit in der Beratung Wirkung entfalten.",
    label: "Kathiago Talent"
  }
];
---

<Layout title="Finanzbildung für Berater, die Verantwortung tragen">
  <!-- 1. HERO -->
  <section class="relative bg-surface pt-20 pb-32 md:pt-32 md:pb-48 overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none">
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-primary/5 rounded-full blur-3xl"></div>
      <div class="absolute top-1/2 -left-24 w-72 h-72 bg-accent/5 rounded-full blur-3xl"></div>
      <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-[0.03]"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid lg:grid-cols-12 gap-y-10 lg:gap-x-12 xl:gap-x-16 items-center">
        <div class="lg:col-span-7">
          <div class="inline-block px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-widest mb-6">
            Zukunft der Finanzberatung
          </div>
          <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-5xl xl:text-7xl 2xl:text-8xl font-bold mb-8 text-navy leading-[1.12] tracking-tight">
            Finanzbildung für Berater, die <span class="text-primary">Verantwortung</span> tragen.
          </h1>
          <div class="max-w-2xl space-y-6 text-xl text-slate-600 mb-12 leading-relaxed">
            <p>
              Die Schweizer Finanzberatung verändert sich fundamental. Regulatorische Anforderungen steigen, Produkte werden komplexer und Kunden erwarten nachvollziehbare, professionelle Beratung.
            </p>
          </div>
          
          <div class="flex flex-col sm:flex-row gap-4 mb-12">
            <a href="/programme/" class="btn-primary text-lg px-8 py-4 shadow-lg shadow-primary/20">Programm finden</a>
            <a href="/kontakt/" class="btn-secondary text-lg px-8 py-4">Strategiegespräch buchen</a>
          </div>

          <div class="flex flex-wrap items-center gap-x-8 gap-y-6 pt-8 border-t border-slate-200/60">
            <div class="flex items-center space-x-2 text-sm font-bold text-slate-400 uppercase tracking-widest">
              <span>Anerkannt durch:</span>
            </div>
            <div class="flex flex-wrap items-center gap-8 opacity-60 grayscale hover:grayscale-0 transition-all duration-500">
              <img src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/vbv%20logo.webp" alt="VBV" class="h-12 w-auto object-contain" />
              <img src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/Eidgeno%CC%88ssische_Finanzmarktaufsicht_logo.svg.png" alt="FINMA" class="h-8 w-auto object-contain" />
              <img src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/SAQ_Logo_CMYK.jpg" alt="SAQ" class="h-8 w-auto object-contain" />
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 relative w-full mt-4 lg:mt-0">
          <div class="relative">
            <div class="absolute -inset-4 bg-gradient-to-tr from-primary/10 to-accent/10 rounded-[2rem] blur-2xl opacity-45"></div>
            <CompetenceSelector client:load />
          </div>
        </div>
      </div>

      <!-- Trust Elements / Vertrauensindikatoren (dreispaltig über die gesamte Breite) -->
      <div class="mt-20 pt-12 border-t border-slate-200/60">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 md:gap-12 text-center sm:text-left">
          <div class="space-y-2">
            <div class="text-4xl md:text-5xl font-black text-navy tracking-tight font-sans">
              750<span class="text-primary">+</span>
            </div>
            <p class="text-sm md:text-base text-slate-500 font-sans leading-relaxed font-medium">
              Absolventen haben Kathiago-Programme abgeschlossen
            </p>
          </div>
          <div class="space-y-2">
            <div class="text-4xl md:text-5xl font-black text-navy tracking-tight font-sans">
              81<span class="text-primary">%</span>
            </div>
            <p class="text-sm md:text-base text-slate-500 font-sans leading-relaxed font-medium">
              Erfolgsquote in der Prüfung
            </p>
          </div>
          <div class="space-y-2">
            <div class="text-4xl md:text-5xl font-black text-navy tracking-tight font-sans">
              120<span class="text-primary">+</span>
            </div>
            <p class="text-sm md:text-base text-slate-500 font-sans leading-relaxed font-medium">
              vergebene Zertifikate seit 2020
            </p>
          </div>
        </div>
      </div>


    </div>
  </section>

  <!-- Video-Testimonials -->
  <section class="section-spacing bg-surface relative overflow-hidden">
    <!-- Decorative background detail -->
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-[0.02] pointer-events-none"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-block px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-widest mb-4">
          Community & Erfolg
        </div>
        <h2 id="testimonials-heading" class="text-3xl md:text-5xl font-bold mb-6 text-navy">
          Echte Stimmen aus der Kathiago-Community
        </h2>
        <p class="text-lg md:text-xl text-slate-600 leading-relaxed font-sans">
          Unsere Talents erzählen, wie sie ihren Weg in der Finanzberatung gehen – mit Haltung, Praxisnähe und Verantwortung.
        </p>
      </div>

      <!-- Video Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-8 mb-16" aria-labelledby="testimonials-heading">
        {videoTestimonials.map((testimonial, i) => {
          let gridClasses = "col-span-1";
          if (i === 3) {
            gridClasses = "md:col-span-1 lg:col-span-2 lg:col-start-2";
          } else if (i === 4) {
            gridClasses = "md:col-span-2 md:max-w-md md:mx-auto md:w-full lg:col-span-2 lg:col-start-4 lg:max-w-none";
          } else {
            gridClasses = "md:col-span-1 lg:col-span-2";
          }

          return (
            <div class={`${gridClasses} flex`} id={`testimonial-card-${i}`}>
              <div class="bg-white border border-slate-200/80 rounded-3xl overflow-hidden shadow-sm hover:shadow-xl hover:border-primary/20 transition-all duration-300 group w-full flex flex-col">
                <!-- Video Pre-loader container -->
                <div class="relative w-full aspect-video bg-slate-900 overflow-hidden">
                  <button
                    class="video-trigger absolute inset-0 w-full h-full text-left focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/40 focus-visible:ring-offset-2 z-10 cursor-pointer"
                    data-video-id={testimonial.id}
                    data-video-title={testimonial.title}
                    aria-label={`Video abspielen: ${testimonial.title}`}
                  >
                    <img
                      src={`https://img.youtube.com/vi/${testimonial.id}/maxresdefault.jpg`}
                      alt={testimonial.title}
                      class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                      onerror="this.onerror=null; this.src='https://img.youtube.com/vi/' + this.dataset.videoId + '/hqdefault.jpg';"
                      data-video-id={testimonial.id}
                    />
                    <!-- Overlay shadow/gradient -->
                    <div class="absolute inset-0 bg-navy/20 group-hover:bg-navy/35 transition-colors duration-300"></div>
                    <!-- Play button icon -->
                    <div class="absolute inset-0 flex items-center justify-center">
                      <div class="w-16 h-16 rounded-full bg-primary text-white flex items-center justify-center shadow-lg transform group-hover:scale-110 transition-transform duration-300">
                        <svg class="w-8 h-8 fill-current ml-1" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                          <path d="M8 5v14l11-7z"/>
                        </svg>
                      </div>
                    </div>
                  </button>
                </div>
                
                <!-- Info details -->
                <div class="p-6 md:p-8 flex flex-col flex-grow">
                  <div class="flex items-center space-x-2 mb-3">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary">
                      {testimonial.label}
                    </span>
                  </div>
                  <h3 class="text-lg md:text-xl font-bold text-navy mb-3 leading-snug">
                    {testimonial.title}
                  </h3>
                  <p class="text-slate-600 text-sm leading-relaxed mb-0">
                    {testimonial.description}
                  </p>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- CTA after Bereich -->
      <div class="max-w-4xl mx-auto bg-white border border-slate-200/60 rounded-3xl p-8 md:p-10 shadow-sm text-center">
        <h4 class="text-xl md:text-2xl font-bold text-navy mb-6">
          Du möchtest deinen nächsten Schritt in der Finanzberatung machen?
        </h4>
        <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
          <a href="/programme/" class="btn-primary w-full sm:w-auto px-8 py-3 text-base">
            Programm finden
          </a>
          <a href="/kontakt/" class="btn-secondary w-full sm:w-auto px-8 py-3 text-base">
            Strategiegespräch buchen
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Client-side Video Dynamic Loader Script -->
  <script>
    const triggers = document.querySelectorAll('.video-trigger');
    triggers.forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        const currentTrigger = e.currentTarget as HTMLElement;
        if (!currentTrigger) return;
        const videoId = currentTrigger.getAttribute('data-video-id');
        const videoTitle = currentTrigger.getAttribute('data-video-title') || 'Video Testimonial';
        if (!videoId) return;

        const container = currentTrigger.parentElement;
        if (!container) return;

        const iframe = document.createElement('iframe');
        iframe.className = 'absolute inset-0 w-full h-full';
        iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
        iframe.title = videoTitle;
        iframe.frameBorder = '0';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        
        container.innerHTML = '';
        container.appendChild(iframe);
      });
    });
  </script>

  <!-- Unsere Bildungsprogramme -->
  <section class="section-spacing bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="inline-block px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-widest mb-4">
          Ausbildungs-Campus
        </div>
        <h2 class="text-3xl md:text-5xl font-bold mb-6 text-navy">Unsere Bildungsprogramme</h2>
        <p class="text-lg text-slate-600 mb-8">
          Eidgenössisch anerkannte Abschlüsse und praxisorientierte Zertifikate – fundiert aufgebaut für Ihren messbaren Erfolg am Beratungstisch.
        </p>
      </div>

      <!-- Real Seminar banner image -->
      <div class="mb-16 rounded-[2rem] overflow-hidden shadow-lg border border-slate-100/50 aspect-[21/9] md:aspect-[24/8] w-full relative group">
        <img 
          src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/03_Seminar_Formal-Weisshemden/kathiago-seminar-formal-01.jpeg" 
          alt="Kathiago Seminarteilnehmer im Präsenzunterricht" 
          class="w-full h-full object-cover object-center group-hover:scale-[1.02] transition-transform duration-700"
          referrerpolicy="no-referrer"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-navy/65 via-navy/15 to-transparent"></div>
        <div class="absolute bottom-6 left-6 md:bottom-8 md:left-10 text-white z-10 max-w-xl">
          <span class="inline-block px-2.5 py-1 rounded bg-primary text-white text-xs font-bold uppercase tracking-widest mb-3">Live-Präsenzunterricht</span>
          <h4 class="text-lg md:text-2xl font-bold tracking-tight mb-1">Professionelles Lernumfeld</h4>
          <p class="text-xs md:text-sm text-slate-200 leading-relaxed hidden sm:block">
            Unsere Seminare kombinieren fundierte Theorie mit intensiver Praxis. In Kleingruppen schärfen Sie Ihre Beratungskompetenz.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {programs.map(program => (
          <div class="card flex flex-col">
            <div class="p-8 flex-grow">
              <div class="text-xs font-bold text-primary uppercase tracking-wider mb-4">{program.data.category}</div>
              <h3 class="text-2xl mb-4">{program.data.title}</h3>
              <p class="text-slate-600 mb-8">{program.data.metaDescription}</p>
              <ul class="space-y-2 mb-8">
                {program.data.modules?.slice(0, 3).map(mod => (
                  <li class="text-sm text-slate-500 flex items-center">
                    <span class="text-primary mr-2">&check;</span> {mod}
                  </li>
                ))}
              </ul>
            </div>
            <div class="p-8 pt-0">
              <a href={`/programme/${program.data.slug || program.id}/`} class="btn-primary w-full">Details & Anmeldung</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Unsere Partner -->
  <section class="section-spacing bg-surface border-t border-b border-slate-100/50 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-navy mb-4">Unsere Partner</h2>
        <p class="text-lg text-slate-600">Firmen, mit denen wir zusammenarbeiten.</p>
      </div>

      <div class="relative w-full py-4">
        <!-- Mask for smooth fade-out edges left and right -->
        <div class="absolute inset-y-0 left-0 w-16 md:w-32 bg-gradient-to-r from-surface to-transparent z-10 pointer-events-none"></div>
        <div class="absolute inset-y-0 right-0 w-16 md:w-32 bg-gradient-to-l from-surface to-transparent z-10 pointer-events-none"></div>

        <div class="marquee-container overflow-hidden flex whitespace-nowrap">
          <!-- Track 1 -->
          <div class="marquee-track flex shrink-0 items-center">
            <img src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/ssm-partner-ag.png" alt="SSM Partner AG Logo" class="h-10 md:h-12 w-auto object-contain mx-6 sm:mx-8 md:mx-10 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" referrerpolicy="no-referrer" />
            <img src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/beyeler-consulting-gmbh.svg" alt="Beyeler Consulting GmbH Logo" class="h-10 md:h-12 w-auto object-contain mx-6 sm:mx-8 md:mx-10 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" referrerpolicy="no-referrer" />
            <img src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/mission-13-gmbh.svg" alt="Mission 13 GmbH Logo" class="h-10 md:h-12 w-auto object-contain mx-6 sm:mx-8 md:mx-10 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" referrerpolicy="no-referrer" />
            <img src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/profinder-gmbh.png" alt="Profinder GmbH Logo" class="h-10 md:h-12 w-auto object-contain mx-6 sm:mx-8 md:mx-10 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" referrerpolicy="no-referrer" />
            <img src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/finwiwo-ag.png" alt="Finwiwo AG Logo" class="h-10 md:h-12 w-auto object-contain mx-6 sm:mx-8 md:mx-10 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" referrerpolicy="no-referrer" />
            <img src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/veritas-finance-ag.png" alt="Veritas Finance AG Logo" class="h-10 md:h-12 w-auto object-contain mx-6 sm:mx-8 md:mx-10 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" referrerpolicy="no-referrer" />
            <img src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/swiss-united-gmbh.png" alt="Swiss United GmbH Logo" class="h-10 md:h-12 w-auto object-contain mx-6 sm:mx-8 md:mx-10 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" referrerpolicy="no-referrer" />
            <img src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/bsafe-invest-gmbh.svg" alt="Bsafe Invest GmbH Logo" class="h-10 md:h-12 w-auto object-contain mx-6 sm:mx-8 md:mx-10 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" referrerpolicy="no-referrer" />
            <img src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/fianza-ag.png" alt="Fianza AG Logo" class="h-10 md:h-12 w-auto object-contain mx-6 sm:mx-8 md:mx-10 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" referrerpolicy="no-referrer" />
            <img src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/satara-consulting-gmbh.svg" alt="Satara Consulting GmbH Logo" class="h-10 md:h-12 w-auto object-contain mx-6 sm:mx-8 md:mx-10 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" referrerpolicy="no-referrer" />
            <img src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/combinvest-ag.png" alt="Combinvest AG Logo" class="h-10 md:h-12 w-auto object-contain mx-6 sm:mx-8 md:mx-10 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" referrerpolicy="no-referrer" />
          </div>
          <!-- Track 2 (Exact copy for seamless looping) -->
          <div class="marquee-track flex shrink-0 items-center" aria-hidden="true">
            <img src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/ssm-partner-ag.png" alt="SSM Partner AG Logo" class="h-10 md:h-12 w-auto object-contain mx-6 sm:mx-8 md:mx-10 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" referrerpolicy="no-referrer" />
            <img src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/beyeler-consulting-gmbh.svg" alt="Beyeler Consulting GmbH Logo" class="h-10 md:h-12 w-auto object-contain mx-6 sm:mx-8 md:mx-10 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" referrerpolicy="no-referrer" />
            <img src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/mission-13-gmbh.svg" alt="Mission 13 GmbH Logo" class="h-10 md:h-12 w-auto object-contain mx-6 sm:mx-8 md:mx-10 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" referrerpolicy="no-referrer" />
            <img src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/profinder-gmbh.png" alt="Profinder GmbH Logo" class="h-10 md:h-12 w-auto object-contain mx-6 sm:mx-8 md:mx-10 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" referrerpolicy="no-referrer" />
            <img src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/finwiwo-ag.png" alt="Finwiwo AG Logo" class="h-10 md:h-12 w-auto object-contain mx-6 sm:mx-8 md:mx-10 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" referrerpolicy="no-referrer" />
            <img src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/veritas-finance-ag.png" alt="Veritas Finance AG Logo" class="h-10 md:h-12 w-auto object-contain mx-6 sm:mx-8 md:mx-10 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" referrerpolicy="no-referrer" />
            <img src="https://raw.githubusercontent.com/yathur-hub/kathiago.ch-assets/main/swiss-united-gmbh.png" alt="Swiss United GmbH Logo" class="h-10 md:h-12 w-auto object-contain mx-6 sm:mx-8 md:mx-10 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" referrerpolicy="no-referrer" />
